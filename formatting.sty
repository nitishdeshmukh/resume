\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{enumitem}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{hyperxmp}
\RequirePackage{titlesec}
\RequirePackage{XCharter}
\RequirePackage{xstring}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{etoolbox}
\RequirePackage{microtype}
\RequirePackage{datetime2}
\RequirePackage{embedfile}

\geometry{a4paper, margin=0.4in}

\raggedright
\pagestyle{empty}
\input{glyphtounicode}
\pdfgentounicode=1

% PDF/UA - mark document as tagged for accessibility
\pdfminorversion=7
\pdfobjcompresslevel=0

\titleformat{\section}
  {\bfseries\large}{}{}{}[\vspace{1pt}\titlerule\vspace{-6.5pt}]

\renewcommand\labelitemi{$\vcenter{\hbox{\small$\bullet$}}$}
\setlist[itemize]{
  itemsep=-2pt,
  leftmargin=12pt,
  topsep=7pt
}

\setlength{\parskip}{0pt}
\setlength{\parindent}{0pt}

\newcommand{\technologies}[1]{\textit{Technologies: #1}}

\newcommand{\shorturl}[1]{%
  \StrSubstitute{#1}{https://}{}[\Result]%
  \StrSubstitute{\Result}{http://}{}[\Result]%
  \StrSubstitute{\Result}{mailto:}{}[\Result]%
  \href{#1}{\Result}%
}

\newcommand{\skills}[2]{\textbf{#1:} #2}

\newcommand{\project}[5]{%
  \textbf{#1} \hfill
  \ifstrempty{#2}{%
    \ifstrempty{#3}{}{\href{#3}{Source Code}}%
  }{%
    \ifstrempty{#3}{\href{#2}{Live Link}}{\href{#2}{Live Link} $|$ \href{#3}{Source Code}}%
  } \\
  \vspace{-9pt}
  \begin{itemize}
    \item \technologies{#4}
    #5
  \end{itemize}
}

\newcommand{\experience}[5]{%
  \noindent\textbf{#1,} {#2} -- #3 \hfill #4 \\
  \vspace{-9pt}
  \begin{itemize}
    #5
  \end{itemize}
}

\newcommand{\education}[5]{%
  \textbf{#1} \hfill #2 \\
  #3 \hfill #4 \\
  #5
}
